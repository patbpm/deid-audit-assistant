# Names of the environment variables the scripts read. Set real values in your
# shell or Windows user environment, never in a file that gets committed.

# Meta Model API. Only the key is required; the other two have defaults
# (https://api.meta.ai/v1 and muse-spark-1.3, per dev.meta.ai/docs).
MODEL_API_KEY=
# META_API_BASE_URL=
# META_API_MODEL=

# Local model (optional; any OpenAI-compatible server, e.g. Ollama or llama.cpp)
# LOCAL_BASE_URL=http://localhost:11434/v1
# LOCAL_MODEL=
